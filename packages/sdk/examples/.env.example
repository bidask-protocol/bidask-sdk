# Mnemonic phrase for your wallet (24 words) - used for funding and transactions
WALLET_MNEMONIC=your wallet mnemonic phrase here

# Mnemonic phrase for your trade account (24 words) - used for signing trade operations
TRADE_ACCOUNT_MNEMONIC=your trade account mnemonic phrase here

# Trade account seed
TRADE_ACCOUNT_SEED=1234567890

# TonCenter API Key
TONCENTER_API_KEY=

# TonCenter API Url
